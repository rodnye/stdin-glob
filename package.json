{
  "name": "stdin-glob",
  "version": "1.8.2",
  "description": "Expand glob patterns and output file contents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "stdin-glob": "./bin/stdin-glob.cjs"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/*"
  ],
  "keywords": [
    "glob",
    "stdin",
    "cli",
    "typescript",
    "fast-glob"
  ],
  "author": "Rodny Estrada<rrodnyestrada1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodnye/stdin-glob.git"
  },
  "bugs": {
    "url": "https://github.com/rodnye/stdin-glob/issues"
  },
  "homepage": "https://github.com/rodnye/stdin-glob#readme",
  "dependencies": {
    "clipboardy": "^5.3.1",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}